# Ensure Linux shell scripts and Device Tree files always use LF line endings
* text=auto
*.sh text eol=lf
*.dts text eol=lf
*.conf text eol=lf
MPI3501-show text eol=lf
MPI3501-hdmi text eol=lf
MPI3501-rotate text eol=lf
MPI3501-diag text eol=lf
LCD35-show text eol=lf
LCD-hdmi text eol=lf
Makefile text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
